# OPERATOR ONLY. These values do not belong in Vercel web functions or VITE_* variables.
# Supply actual values through a secure local/operator secret store. Do not commit them.
REDZEN_AUDIT_DATABASE_URL=
REDZEN_DATABASE_HOST=
REDZEN_EXPECTED_DATABASE_NAME=

# Exact immutable protected PREVIEW URL, never a production/custom domain or branch alias.
REDZEN_PREVIEW_URL=
REDZEN_EXPECTED_PREVIEW_HOST=
# Set true only after checking team, project ID, immutable deployment SHA,
# protection settings and the dedicated empty PREVIEW database in provider dashboards.
REDZEN_PREVIEW_TARGET_CONFIRMED=false
REDZEN_PREVIEW_BYPASS_SECRET=
