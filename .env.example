# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Legacy email settings. Sending reservation emails remains disabled.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM="RedZen Private Eco Wellness <reserveringen@redzensuites.nl>"

# Option B: server-only Vercel/Neon settings, scoped separately for Preview and Production.
# Never prefix credentials with VITE_. Existing BaddBeatz project must not be used.
REDZEN_VERCEL_PROJECT_ID=
# Intake stays disabled until the database, protection, privacy and acceptance checks are approved.
REDZEN_INTAKE_ENABLED=false
# Runtime connection: dedicated redzen_intake login, sslmode=require, a dedicated Neon database.
# Set the actual secret directly in the new project's secret environment settings.
DATABASE_URL=
REDZEN_DATABASE_HOST=
# Random server-only secret, at least 32 characters. Do not log or reuse other app credentials.
REDZEN_RATE_LIMIT_SECRET=

# Standalone server only; never use /tmp or a public/build directory for real applications.
NODE_ENV=production
PORT=3000
LEAD_STORAGE_PATH=

# Keep false until the operator has approved privacy copy, processors/region,
# purpose-based retention, cleanup schedule, backup expiry and deletion replay.
REDZEN_PRIVACY_READY=false
# No default policy: set approved whole-day values (1..3650), separately per environment.
REDZEN_APPLICATION_RETENTION_DAYS=
REDZEN_RATE_BUCKET_RETENTION_DAYS=
REDZEN_BACKUP_RETENTION_DAYS=
# Separate restricted maintenance login; never expose it to intake functions.
REDZEN_MAINTENANCE_DATABASE_URL=
